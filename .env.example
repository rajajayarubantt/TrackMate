# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables instead.
# Never commit real values: .env.local is ignored by git.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# It contains your database password, so treat it like one.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Signs the sign-in cookie. Any long random text; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

# Optional. The database inside the cluster. Defaults to "trackmate".
# MONGODB_DB=trackmate

# Optional. Set to "closed" once you have created your account, so nobody else can sign up.
# SIGNUP=closed
